# NASA ADS API token. Server only; never use a VITE_ prefix.
# Get your personal token from your NASA ADS account's API settings.
# Locally, npm run dev / npm run preview refresh on startup and daily at 06:00 UTC.
# Leave the server running and the computer awake for scheduled updates.
ADS_TOKEN=

# CRON_SECRET is a private random password, NOT a duration or schedule.
# It has no units. It protects /api/refresh-papers from unauthorized requests.
# Vercel sends it as: Authorization: Bearer <CRON_SECRET>
# Our server checks that password before refreshing the paper list.
#
# A value is already generated in your local .env. Copy that same value into
# Vercel's environment variable named CRON_SECRET; do not use this blank template.
# For a fresh setup, generate a value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste the resulting 64-character string after CRON_SECRET= (no angle brackets).
# Keep it private, server-side, and out of Git. Never use a VITE_ prefix.
#
# Timing is configured separately in vercel.json: "0 6 * * *" = daily at 06:00 UTC.
# Changing CRON_SECRET does not change the schedule or the 24-hour cache lifetime.
CRON_SECRET=
